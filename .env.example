# ===== MySQL =====
# 后端连接 MySQL 的用户名（只传给 backend 的 DB_USER，不会作为 MySQL 容器的 MYSQL_USER）
# 如需非 root 账号，请先在 MySQL 中手动创建并授权
MYSQL_USER=root
# MySQL root 密码（compose 直接注入容器的 MYSQL_ROOT_PASSWORD，并作为后端 DB_PASSWORD）
MYSQL_ROOT_PASSWORD=change-me-strong-password
# MySQL 容器端口 / 后端 DB_PORT
MYSQL_TCP_PORT=3306
# 数据库名
MYSQL_DB_NAME=wecom_relay

# ===== 后端基础 =====
# 后端容器内部端口，必须与 web/nginx.conf 中 proxy_pass 的 8888 保持一致
BACKEND_PORT=8888
# 外层 nginx 只需代理到 frontend 的 FRONTEND_PORT，backend/mysql 不需要映射到宿主机
# 注意：企微回调 URL 建议指向 nginx 的 https://域名/wecom/callback

# ===== 后端安全 =====
# JWT 签名密钥，至少 16 字符，建议使用 openssl rand -hex 32 生成
JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=24
# 敏感配置加密密钥（Secret/Token/AESKey/auth_config 等），至少 16 字符
# 重要：一旦更换或丢失，将无法解密数据库中已保存的敏感字段
CONFIG_ENCRYPT_KEY=please-change-to-another-random-string

# 首次启动时创建的管理员；密码至少 8 位。创建后修改环境变量不会重置已有密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ===== 跨域 =====
# 跨域白名单，逗号分隔；* 表示允许全部（生产建议改为管理后台域名）
CORS_ALLOW_ORIGINS=*

# ===== Worker =====
# 轮询间隔（秒）与并发数
WORKER_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=8
# 重试退避（秒），逗号分隔；序列耗尽后使用最后一个值
# 默认 1,2,4,8,16；固定每 30 分钟重试一次填 1800
RETRY_BACKOFF_SECONDS=1,2,4,8,16
# 企微回调时间戳允许偏差（秒）
CALLBACK_MAX_SKEW_SECONDS=300

# ===== 日志 =====
# info；临时排查可设为 debug，输出企微入站/出站报文摘要（不含 Token/AESKey/Secret）
LOG_LEVEL=info
# DEBUG 日志是否输出明文事件/JSON Body（含 user_id/department 等 PII），默认关闭
RELAY_LOG_RAW_EVENTS=false

# ===== 前端 =====
FRONTEND_PORT=8889
